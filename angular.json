{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"analytics": false},
  "projects": {
    "portfolio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {"base": "build", "browser": ""},
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*", "input": "public", "output": "/"}],
            "styles": ["src/styles.css"],
            "outputHashing": "all",
            "budgets": [{"type": "initial", "maximumWarning": "500kB", "maximumError": "750kB"}]
          }
        },
        "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "portfolio:build"}}
      }
    }
  }
}
